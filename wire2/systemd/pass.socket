# wire2's reference filter `pass` (SPEC.md "Reference filter: pass"), started on the proxy's first
# connection. User unit: copy to ~/.config/systemd/user/ and `systemctl --user enable --now pass.socket`.
[Unit]
Description=wire2 filter pass (socket)

[Socket]
ListenStream=%t/pass.sock
SocketMode=0600
Accept=no

[Install]
WantedBy=sockets.target
